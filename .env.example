# Bu dosyayı .env olarak kopyalayın (.env repoya yüklenmez).
# Yerel testlerde işlemleri hızlandırmak için 480p kullanın. Varsayılan: 1080
KAC_QUALITY=480
# İndirilen dosyaların yazılacağı klasör. Varsayılan: workspace
KAC_WORKDIR=workspace
# Sohbet indirme için paralel iş parçacığı sayısı. Varsayılan: 16
KAC_CHAT_WORKERS=16
# Video kodlayıcı: auto (NVIDIA GPU varsa kullanır), nvenc, cpu. Varsayılan: auto
KAC_ENCODER=auto
# Altyazı modeli (tiny, base, small, medium, large-v3, large-v3-turbo). Varsayılan: large-v3-turbo
# GPU yoksa yerel testlerde 'small' daha hızlıdır.
KAC_WHISPER_MODEL=large-v3-turbo
